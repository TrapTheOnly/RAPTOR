{
  "key": "snmp-security",
  "name": "SNMP Security Checklist",
  "service": "snmp",
  "source": "CIS Network Device Benchmarks + NIST SP 800-53",
  "auto_ports": [
    161,
    162
  ],
  "sections": [
    {
      "name": "Protocol and Version Security",
      "items": [
        {
          "id": "SNMP-001",
          "testName": "SNMPv1/v2c deprecation checks",
          "description": "Eliminate legacy community-string-only protocols where feasible.",
          "tools": "device config review"
        },
        {
          "id": "SNMP-002",
          "testName": "SNMPv3 requirement validation",
          "description": "Enforce SNMPv3 with authPriv for managed infrastructure.",
          "tools": "config audit"
        },
        {
          "id": "SNMP-003",
          "testName": "Weak community string detection",
          "description": "Identify default/guessable communities and retire them.",
          "tools": "snmpwalk testing"
        },
        {
          "id": "SNMP-004",
          "testName": "Read/write community restrictions",
          "description": "Restrict write access and separate privileged operations paths.",
          "tools": "config review"
        },
        {
          "id": "SNMP-005",
          "testName": "Engine ID and user config consistency",
          "description": "Validate secure user/account setup across devices.",
          "tools": "SNMPv3 config audit"
        },
        {
          "id": "SNMP-006",
          "testName": "Trap source integrity checks",
          "description": "Ensure trap senders are authenticated and expected.",
          "tools": "NMS config review"
        },
        {
          "id": "SNMP-007",
          "testName": "Protocol downgrade resistance",
          "description": "Confirm monitoring stack does not silently fall back to insecure modes.",
          "tools": "collector validation"
        }
      ]
    },
    {
      "name": "Access Scope and Data Exposure",
      "items": [
        {
          "id": "SNMP-008",
          "testName": "ACL/source restriction validation",
          "description": "Limit SNMP query sources to approved monitoring systems.",
          "tools": "device ACL audit"
        },
        {
          "id": "SNMP-009",
          "testName": "MIB exposure minimization",
          "description": "Restrict access to sensitive OIDs not required for operations.",
          "tools": "MIB view configuration"
        },
        {
          "id": "SNMP-010",
          "testName": "Sensitive data leak checks",
          "description": "Verify credentials/system secrets are not exposed via SNMP values.",
          "tools": "snmpwalk + review"
        },
        {
          "id": "SNMP-011",
          "testName": "Write operation control testing",
          "description": "Ensure unauthorized set operations are denied and logged.",
          "tools": "snmpset testing"
        },
        {
          "id": "SNMP-012",
          "testName": "Network segmentation for management plane",
          "description": "Isolate SNMP traffic from user/data plane networks.",
          "tools": "network architecture review"
        },
        {
          "id": "SNMP-013",
          "testName": "Trap destination authorization",
          "description": "Ensure traps are sent only to trusted collectors.",
          "tools": "device/NMS config review"
        },
        {
          "id": "SNMP-014",
          "testName": "Inventory parity of managed devices",
          "description": "Detect unmanaged devices exposing SNMP unexpectedly.",
          "tools": "asset discovery"
        }
      ]
    },
    {
      "name": "Monitoring, Resilience and Governance",
      "items": [
        {
          "id": "SNMP-015",
          "testName": "SNMP auth failure alerting",
          "description": "Alert on repeated authentication failures and probing behavior.",
          "tools": "SIEM + NMS alerts"
        },
        {
          "id": "SNMP-016",
          "testName": "Configuration drift detection",
          "description": "Detect unauthorized changes to SNMP users, ACLs, or views.",
          "tools": "config compliance tooling"
        },
        {
          "id": "SNMP-017",
          "testName": "Firmware patch posture",
          "description": "Keep network device firmware updated for SNMP-related vulnerabilities.",
          "tools": "vuln mgmt"
        },
        {
          "id": "SNMP-018",
          "testName": "Collector hardening and HA readiness",
          "description": "Harden NMS collectors and validate high-availability failover.",
          "tools": "NMS ops review"
        },
        {
          "id": "SNMP-019",
          "testName": "Credential rotation process",
          "description": "Rotate SNMPv3 credentials and retire stale communities on schedule.",
          "tools": "secret management runbook"
        },
        {
          "id": "SNMP-020",
          "testName": "Incident playbooks for device compromise",
          "description": "Define isolation and remediation flow for compromised managed devices.",
          "tools": "IR documentation"
        },
        {
          "id": "SNMP-021",
          "testName": "Audit trail retention policy",
          "description": "Retain SNMP security events and change logs per policy.",
          "tools": "logging policy review"
        }
      ]
    }
  ]
}
