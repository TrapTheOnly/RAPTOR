FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy

RUN set -eux; \
    proxy_http="${HTTP_PROXY:-${http_proxy:-}}"; \
    proxy_https="${HTTPS_PROXY:-${https_proxy:-$proxy_http}}"; \
    if [ -n "$proxy_http" ]; then \
      echo "Acquire::HTTP::Proxy \"$proxy_http\";" > /etc/apt/apt.conf.d/99proxy; \
    fi; \
    if [ -n "$proxy_https" ]; then \
      if [ -f /etc/apt/apt.conf.d/99proxy ]; then \
        echo "Acquire::HTTPS::Proxy \"$proxy_https\";" >> /etc/apt/apt.conf.d/99proxy; \
      else \
        echo "Acquire::HTTPS::Proxy \"$proxy_https\";" > /etc/apt/apt.conf.d/99proxy; \
      fi; \
    fi; \
    printf '%s\n' \
      'deb http://kali.download/kali kali-rolling main contrib non-free non-free-firmware' \
      > /etc/apt/sources.list; \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      kali-archive-keyring \
      python3 \
      python3-pip \
      nmap \
      nikto \
      whatweb \
      sslscan \
      dirb \
      gobuster \
      ffuf \
      nuclei \
      sqlmap \
      hydra \
      john \
      wpscan \
      enum4linux \
      wordlists \
      seclists \
      curl \
      git \
      dnsutils \
      netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/99proxy

# Pre-download nuclei templates at build time (proxy available here via ARG)
RUN set -eux; \
    proxy_https="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"; \
    if [ -n "$proxy_https" ]; then \
      HTTPS_PROXY="$proxy_https" HTTP_PROXY="$proxy_https" nuclei -update-templates 2>/dev/null || true; \
    else \
      nuclei -update-templates 2>/dev/null || true; \
    fi

COPY scanner/mcp-kali-server/requirements.txt /opt/kali-server/requirements.txt
RUN set -eux; \
    pip_proxy="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"; \
    if [ -n "$pip_proxy" ]; then \
      pip3 install --no-cache-dir --proxy "$pip_proxy" --break-system-packages -r /opt/kali-server/requirements.txt; \
    else \
      pip3 install --no-cache-dir --break-system-packages -r /opt/kali-server/requirements.txt; \
    fi

RUN set -eux; \
    git_proxy="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"; \
    if [ -n "$git_proxy" ]; then export HTTPS_PROXY="$git_proxy" HTTP_PROXY="$git_proxy"; fi; \
    git clone --depth 1 https://github.com/ticarpi/jwt_tool.git /opt/jwt_tool; \
    if [ -f /opt/jwt_tool/requirements.txt ]; then \
      pip3 install --no-cache-dir --break-system-packages -r /opt/jwt_tool/requirements.txt || true; \
    fi; \
    pip3 install --no-cache-dir --break-system-packages pycryptodomex pycryptodome termcolor

COPY scanner/knowledge/jwt-secrets.txt /opt/jwt_tool/jwt-secrets.txt
COPY scanner/mcp-kali-server/server.py /opt/kali-server/server.py
# jwt_tool's createConfig() writes comment-keys that Python 3.14 rejects. Bake a real ini.
RUN python3 -c "import importlib.util; spec=importlib.util.spec_from_file_location('kali_server', '/opt/kali-server/server.py'); mod=importlib.util.module_from_spec(spec); spec.loader.exec_module(mod); mod.ensure_jwt_tool_config()"

EXPOSE 5000

CMD ["python3", "/opt/kali-server/server.py", "--ip", "0.0.0.0", "--port", "5000"]
