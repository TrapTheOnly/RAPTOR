{
  "key": "smb-security",
  "name": "SMB Security Checklist",
  "service": "smb",
  "source": "CIS Microsoft/Windows Benchmarks + NIST 800-171",
  "auto_ports": [
    139,
    445
  ],
  "sections": [
    {
      "name": "Protocol and Transport Hardening",
      "items": [
        {
          "id": "SMB-001",
          "testName": "SMBv1 disablement verification",
          "description": "Ensure SMBv1 is disabled across servers and clients.",
          "tools": "PowerShell, nmap smb-protocols"
        },
        {
          "id": "SMB-002",
          "testName": "SMB signing enforcement",
          "description": "Validate message signing is required and cannot be downgraded.",
          "tools": "GPO review, packet capture"
        },
        {
          "id": "SMB-003",
          "testName": "SMB encryption policy",
          "description": "Enable and verify SMB encryption where sensitive data traverses untrusted segments.",
          "tools": "smbclient, policy review"
        },
        {
          "id": "SMB-004",
          "testName": "Null session and guest access checks",
          "description": "Block anonymous and guest-based access to shares and IPC.",
          "tools": "rpcclient, smbclient"
        },
        {
          "id": "SMB-005",
          "testName": "Name resolution poisoning resilience",
          "description": "Assess controls against NBNS/LLMNR poisoning-related SMB abuse.",
          "tools": "network config review"
        },
        {
          "id": "SMB-006",
          "testName": "NTLM hardening posture",
          "description": "Reduce NTLM usage and enforce secure negotiation paths.",
          "tools": "GPO/security policy"
        },
        {
          "id": "SMB-007",
          "testName": "Firewall segmentation for SMB",
          "description": "Restrict SMB exposure to approved subnets and service dependencies.",
          "tools": "firewall review"
        }
      ]
    },
    {
      "name": "Access Control and Share Governance",
      "items": [
        {
          "id": "SMB-008",
          "testName": "Share inventory and ownership",
          "description": "Maintain accurate inventory of shares, owners, and business purpose.",
          "tools": "CMDB + scripted inventory"
        },
        {
          "id": "SMB-009",
          "testName": "Least-privilege ACL validation",
          "description": "Ensure share and NTFS ACLs enforce least privilege.",
          "tools": "icacls, access review"
        },
        {
          "id": "SMB-010",
          "testName": "Administrative share restrictions",
          "description": "Review and limit exposure of admin shares where feasible.",
          "tools": "policy review"
        },
        {
          "id": "SMB-011",
          "testName": "Sensitive data exposure checks",
          "description": "Identify shares exposing secrets, backups, or credential material.",
          "tools": "DLP scan, manual review"
        },
        {
          "id": "SMB-012",
          "testName": "Ransomware blast-radius controls",
          "description": "Validate write/delete protections and segmentation for critical shares.",
          "tools": "control validation"
        },
        {
          "id": "SMB-013",
          "testName": "Shadow copy and rollback readiness",
          "description": "Ensure secure snapshot/rollback strategy for destructive events.",
          "tools": "backup tooling"
        },
        {
          "id": "SMB-014",
          "testName": "Cross-domain trust access review",
          "description": "Review trust relationships affecting SMB authorization scope.",
          "tools": "AD trust review"
        }
      ]
    },
    {
      "name": "Detection and Operational Resilience",
      "items": [
        {
          "id": "SMB-015",
          "testName": "Audit policy for file/share events",
          "description": "Capture read/write/delete and permission change events where needed.",
          "tools": "Windows auditing"
        },
        {
          "id": "SMB-016",
          "testName": "Anomalous SMB traffic detection",
          "description": "Alert on scanning, brute-force, and mass-encryption behavior patterns.",
          "tools": "SIEM, NDR"
        },
        {
          "id": "SMB-017",
          "testName": "Credential theft and relay defenses",
          "description": "Assess protections against pass-the-hash and NTLM relay techniques.",
          "tools": "attack simulation"
        },
        {
          "id": "SMB-018",
          "testName": "Patch baseline for SMB stack",
          "description": "Track and remediate SMB-related CVEs on an accelerated timeline.",
          "tools": "vuln mgmt"
        },
        {
          "id": "SMB-019",
          "testName": "Service account and machine account hygiene",
          "description": "Review delegated privileges and stale account usage.",
          "tools": "AD audit"
        },
        {
          "id": "SMB-020",
          "testName": "Incident containment runbooks",
          "description": "Test share isolation and credential reset playbooks for SMB incidents.",
          "tools": "tabletop + drill"
        },
        {
          "id": "SMB-021",
          "testName": "Backup integrity and restore tests",
          "description": "Validate immutable backup and recovery processes for SMB-hosted data.",
          "tools": "restore testing"
        }
      ]
    }
  ]
}
