FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy

RUN set -eux; \
    proxy_http="${HTTP_PROXY:-${http_proxy:-}}"; \
    proxy_https="${HTTPS_PROXY:-${https_proxy:-$proxy_http}}"; \
    if [ -n "$proxy_http" ]; then \
      echo "Acquire::HTTP::Proxy \"$proxy_http\";" > /etc/apt/apt.conf.d/99proxy; \
    fi; \
    if [ -n "$proxy_https" ]; then \
      if [ -f /etc/apt/apt.conf.d/99proxy ]; then \
        echo "Acquire::HTTPS::Proxy \"$proxy_https\";" >> /etc/apt/apt.conf.d/99proxy; \
      else \
        echo "Acquire::HTTPS::Proxy \"$proxy_https\";" > /etc/apt/apt.conf.d/99proxy; \
      fi; \
    fi; \
    printf '%s\n' \
      'deb http://kali.download/kali kali-rolling main contrib non-free non-free-firmware' \
      > /etc/apt/sources.list; \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      kali-archive-keyring \
      python3 \
      python3-pip \
      nmap \
      nikto \
      whatweb \
      sslscan \
      dirb \
      gobuster \
      ffuf \
      sqlmap \
      hydra \
      john \
      wpscan \
      enum4linux \
      golang-go \
      curl \
      dnsutils \
      netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/99proxy

RUN go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest \
    && mv /root/go/bin/nuclei /usr/local/bin/nuclei

COPY scanner/mcp-kali-server/requirements.txt /opt/kali-server/requirements.txt
RUN set -eux; \
    pip_proxy="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"; \
    if [ -n "$pip_proxy" ]; then \
      pip3 install --no-cache-dir --proxy "$pip_proxy" --break-system-packages -r /opt/kali-server/requirements.txt; \
    else \
      pip3 install --no-cache-dir --break-system-packages -r /opt/kali-server/requirements.txt; \
    fi

COPY scanner/mcp-kali-server/server.py /opt/kali-server/server.py

EXPOSE 5000

CMD ["python3", "/opt/kali-server/server.py", "--ip", "0.0.0.0", "--port", "5000"]
