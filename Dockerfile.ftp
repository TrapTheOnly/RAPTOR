FROM python:3.12-slim

# Define build arguments for the proxy
ARG http_proxy
ARG ftp_user
ARG ftp_pass

# Set environment variables
ENV http_proxy=$http_proxy
ENV https_proxy=$http_proxy

RUN pip install pyftpdlib

# Create the FTP user's home directory if it doesn't exist
# RUN if ! id ftpuser &>/dev/null; then \
#     useradd -m ftpuser; \
# fi
RUN mkdir -p /ftp/reports && chown ftpuser:ftpuser /ftp/reports

# Expose the FTP port
USER ftpuser
EXPOSE 21

# Run pyftpdlib with environment variables
RUN echo '${ftp_pass} ${ftp_user}'

CMD ["python", "-m", "pyftpdlib", "-i", "0.0.0.0", "-p", "21", "--username", "$ftp_user", "--password", "$ftp_pass", "--directory", "/ftp/reports"]
