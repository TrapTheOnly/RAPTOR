FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy

RUN set -eux; \
    proxy_http="${HTTP_PROXY:-${http_proxy:-}}"; \
    proxy_https="${HTTPS_PROXY:-${https_proxy:-$proxy_http}}"; \
    if [ -n "$proxy_http" ]; then \
      echo "Acquire::HTTP::Proxy \"$proxy_http\";" > /etc/apt/apt.conf.d/99proxy; \
    fi; \
    if [ -n "$proxy_https" ]; then \
      if [ -f /etc/apt/apt.conf.d/99proxy ]; then \
        echo "Acquire::HTTPS::Proxy \"$proxy_https\";" >> /etc/apt/apt.conf.d/99proxy; \
      else \
        echo "Acquire::HTTPS::Proxy \"$proxy_https\";" > /etc/apt/apt.conf.d/99proxy; \
      fi; \
    fi; \
    printf '%s\n' \
      'deb http://kali.download/kali kali-rolling main contrib non-free non-free-firmware' \
      > /etc/apt/sources.list; \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      kali-archive-keyring \
      mcp-kali-server \
      nmap \
      nikto \
      whatweb \
      sslscan \
      dirb \
      gobuster \
      curl \
      dnsutils \
      netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/99proxy

EXPOSE 5000

CMD ["kali-server-mcp", "--ip", "0.0.0.0", "--port", "5000"]