FROM python:3.12-slim

# Define build arguments for the proxy
ARG http_proxy

# Set environment variables *during the build*
ENV http_proxy=$http_proxy
ENV https_proxy=$http_proxy

RUN pip install pyftpdlib

# Create the FTP user's home directory
RUN mkdir -p /home/ftpuser

# Expose the FTP port
EXPOSE 21

# Set default username, directory, and password from environment variables
ENV FTP_USER=ftpuser
ENV FTP_DIRECTORY=/home/ftpuser
ENV FTP_PASS=${FTP_PASS}

# Directly run pyftpdlib with environment variables
CMD ["python", "-m", "pyftpdlib", "-i", "0.0.0.0", "-p", "21", "--username", "${FTP_USER}", "--password", "${FTP_PASS}", "--directory", "${FTP_DIRECTORY}"]