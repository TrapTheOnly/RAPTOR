      },
      {
        "name": "raptor-user",
        "description": "RAPTOR User role",
        "composite": true
      },
      {
        "name": "raptor-pentester",
        "description": "RAPTOR Pentester role",
        "composite": true
      },
      {
        "name": "raptor-manager",
        "description": "RAPTOR Manager role",
        "composite": true
      },
      {
        "name": "raptor-admin",
        "description": "RAPTOR Admin role",
        "composite": true
      }
    ],
    "client": {
