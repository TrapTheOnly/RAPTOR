# --- Base Image and Environment Setup ---
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy
RUN set -eux; \
    proxy_http="${HTTP_PROXY:-${http_proxy:-}}"; \
    proxy_https="${HTTPS_PROXY:-${https_proxy:-$proxy_http}}"; \
    if [ -n "$proxy_http" ]; then \
      echo "Acquire::HTTP::Proxy \"$proxy_http\";" > /etc/apt/apt.conf.d/99proxy; \
    fi; \
    if [ -n "$proxy_https" ]; then \
      if [ -f /etc/apt/apt.conf.d/99proxy ]; then \
        echo "Acquire::HTTPS::Proxy \"$proxy_https\";" >> /etc/apt/apt.conf.d/99proxy; \
      else \
        echo "Acquire::HTTPS::Proxy \"$proxy_https\";" > /etc/apt/apt.conf.d/99proxy; \
      fi; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/99proxy
RUN mkdir -p /run/sshd

# --- User and SSH Configuration ---
RUN groupadd sftpusers && \
    useradd -m -g sftpusers -s /usr/sbin/nologin sftpuser
RUN mkdir -p /home/sftpuser/.ssh && \
    chmod 700 /home/sftpuser/.ssh && \
    chown sftpuser:sftpusers /home/sftpuser/.ssh
RUN sed -i 's@#Subsystem sftp /usr/lib/openssh/sftp-server@Subsystem sftp internal-sftp@g' /etc/ssh/sshd_config && \
    echo "\
Match User sftpuser\n\
    ChrootDirectory /chroot\n\
    ForceCommand internal-sftp\n\
    X11Forwarding no\n\
    AllowTcpForwarding no\n\
" >> /etc/ssh/sshd_config
RUN mkdir -p /chroot/upload && \
    chown root:root /chroot && \
    chmod 755 /chroot && \
    chown sftpuser:sftpusers /chroot/upload
    
# --- Final Setup and Start ---
EXPOSE 22
ARG DNS_SERVER_SSH_PUBKEY
RUN touch /home/sftpuser/.ssh/authorized_keys && \
    if [ -n "$DNS_SERVER_SSH_PUBKEY" ]; then echo "$DNS_SERVER_SSH_PUBKEY" >> /home/sftpuser/.ssh/authorized_keys; fi && \
    chown sftpuser:sftpusers /home/sftpuser/.ssh/authorized_keys && \
    chmod 600 /home/sftpuser/.ssh/authorized_keys
CMD ["/usr/sbin/sshd", "-D"]
