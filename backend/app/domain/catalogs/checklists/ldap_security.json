{
  "key": "ldap-security",
  "name": "LDAP Directory Security Checklist",
  "service": "ldap",
  "source": "NIST SP 800-63 + CIS AD/LDAP Benchmarks",
  "auto_ports": [
    389,
    636
  ],
  "sections": [
    {
      "name": "Transport and Bind Security",
      "items": [
        {
          "id": "LDAP-001",
          "testName": "LDAPS/TLS enforcement checks",
          "description": "Require encrypted transport for binds and directory queries.",
          "tools": "openssl, ldapsearch"
        },
        {
          "id": "LDAP-002",
          "testName": "StartTLS downgrade resistance",
          "description": "Validate safe behavior when StartTLS negotiation fails.",
          "tools": "ldapsearch tests"
        },
        {
          "id": "LDAP-003",
          "testName": "Simple bind over cleartext prevention",
          "description": "Block insecure simple binds on non-encrypted channels.",
          "tools": "directory policy review"
        },
        {
          "id": "LDAP-004",
          "testName": "Certificate and trust chain validation",
          "description": "Verify directory server certificates and CA trust configuration.",
          "tools": "openssl s_client"
        },
        {
          "id": "LDAP-005",
          "testName": "SASL mechanism hardening",
          "description": "Restrict to approved SASL mechanisms and disable weak options.",
          "tools": "directory config audit"
        },
        {
          "id": "LDAP-006",
          "testName": "Anonymous bind policy review",
          "description": "Disable or tightly restrict anonymous bind/search capabilities.",
          "tools": "ldapsearch anonymous tests"
        },
        {
          "id": "LDAP-007",
          "testName": "Referral handling security checks",
          "description": "Ensure referral chasing does not leak credentials or data.",
          "tools": "client config review"
        }
      ]
    },
    {
      "name": "Authorization, Schema and Data Protection",
      "items": [
        {
          "id": "LDAP-008",
          "testName": "ACL least-privilege evaluation",
          "description": "Ensure directory ACLs limit read/write privileges appropriately.",
          "tools": "acl review"
        },
        {
          "id": "LDAP-009",
          "testName": "Privileged group exposure checks",
          "description": "Audit access paths to high-privilege groups and attributes.",
          "tools": "directory audit"
        },
        {
          "id": "LDAP-010",
          "testName": "Sensitive attribute access controls",
          "description": "Restrict credential and security-sensitive attributes from broad reads.",
          "tools": "schema/ACL review"
        },
        {
          "id": "LDAP-011",
          "testName": "Password policy enforcement",
          "description": "Validate complexity, lockout, history, and lifetime controls.",
          "tools": "policy tests"
        },
        {
          "id": "LDAP-012",
          "testName": "Replication channel security",
          "description": "Protect replication traffic and credentials between directory nodes.",
          "tools": "replication config review"
        },
        {
          "id": "LDAP-013",
          "testName": "Schema change governance",
          "description": "Require approval and traceability for schema extensions.",
          "tools": "change control records"
        },
        {
          "id": "LDAP-014",
          "testName": "Service account bind minimization",
          "description": "Limit bind permissions and scope for application service accounts.",
          "tools": "app integration review"
        }
      ]
    },
    {
      "name": "Operations, Detection and Recovery",
      "items": [
        {
          "id": "LDAP-015",
          "testName": "Directory auth event logging",
          "description": "Capture successful/failed bind events and privileged changes.",
          "tools": "SIEM + directory logs"
        },
        {
          "id": "LDAP-016",
          "testName": "LDAP injection resistance in clients",
          "description": "Validate integrated applications properly sanitize LDAP inputs.",
          "tools": "app testing, code review"
        },
        {
          "id": "LDAP-017",
          "testName": "Configuration drift monitoring",
          "description": "Detect unauthorized changes to ACLs, policies, and trust settings.",
          "tools": "compliance tooling"
        },
        {
          "id": "LDAP-018",
          "testName": "Patch and vulnerability management",
          "description": "Track CVEs for directory servers and dependent plugins/modules.",
          "tools": "vuln mgmt"
        },
        {
          "id": "LDAP-019",
          "testName": "Backup and authoritative restore validation",
          "description": "Test secure restore procedures for directory integrity.",
          "tools": "DR exercise"
        },
        {
          "id": "LDAP-020",
          "testName": "Incident response for identity compromise",
          "description": "Validate disable/reset/containment workflows for identity attacks.",
          "tools": "IR drills"
        },
        {
          "id": "LDAP-021",
          "testName": "Key and certificate rotation governance",
          "description": "Maintain lifecycle controls for LDAP TLS certificates and keys.",
          "tools": "PKI runbook"
        }
      ]
    }
  ]
}
