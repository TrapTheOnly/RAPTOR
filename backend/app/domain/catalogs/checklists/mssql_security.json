{
  "key": "mssql-security",
  "name": "Microsoft SQL Server Security Checklist",
  "service": "mssql",
  "source": "CIS SQL Server Benchmark + Microsoft Security Baselines",
  "auto_ports": [
    1433
  ],
  "sections": [
    {
      "name": "Surface Area and Transport Hardening",
      "items": [
        {
          "id": "MSSQL-001",
          "testName": "Network exposure and firewall restrictions",
          "description": "Limit SQL Server access to approved application and admin networks.",
          "tools": "netstat + firewall review"
        },
        {
          "id": "MSSQL-002",
          "testName": "TLS encryption requirement checks",
          "description": "Require encrypted connections and verify cert deployment.",
          "tools": "SQL Server config + packet capture"
        },
        {
          "id": "MSSQL-003",
          "testName": "Legacy protocol disablement",
          "description": "Disable deprecated protocols/features that increase attack surface.",
          "tools": "SQL Server configuration manager"
        },
        {
          "id": "MSSQL-004",
          "testName": "Browser service necessity review",
          "description": "Disable SQL Browser where not required to reduce enumeration surface.",
          "tools": "service review"
        },
        {
          "id": "MSSQL-005",
          "testName": "xp_cmdshell and dangerous feature controls",
          "description": "Disable high-risk extended procedures unless explicitly approved.",
          "tools": "sp_configure audit"
        },
        {
          "id": "MSSQL-006",
          "testName": "Instance naming/fingerprint exposure check",
          "description": "Reduce unnecessary service detail disclosure.",
          "tools": "nmap, sqlcmd tests"
        },
        {
          "id": "MSSQL-007",
          "testName": "Linked server trust boundary review",
          "description": "Validate linked server configurations and credential flow controls.",
          "tools": "linked server audit"
        }
      ]
    },
    {
      "name": "Identity, Authorization and Data Controls",
      "items": [
        {
          "id": "MSSQL-008",
          "testName": "sa account hardening and monitoring",
          "description": "Rename/disable where possible and enforce strong controls.",
          "tools": "login audit"
        },
        {
          "id": "MSSQL-009",
          "testName": "Windows vs SQL auth policy validation",
          "description": "Prefer integrated auth and constrain SQL auth usage.",
          "tools": "security policy review"
        },
        {
          "id": "MSSQL-010",
          "testName": "Role membership least privilege review",
          "description": "Audit server/database role memberships for privilege excess.",
          "tools": "sys.server_role_members"
        },
        {
          "id": "MSSQL-011",
          "testName": "Granular permission auditing",
          "description": "Review object-level permissions for sensitive schemas/tables.",
          "tools": "permission scripts"
        },
        {
          "id": "MSSQL-012",
          "testName": "TDE and backup encryption posture",
          "description": "Validate encryption at rest and encrypted backup workflows.",
          "tools": "TDE config review"
        },
        {
          "id": "MSSQL-013",
          "testName": "Always Encrypted/data masking policy checks",
          "description": "Assess controls for highly sensitive fields and privileged access.",
          "tools": "schema/security review"
        },
        {
          "id": "MSSQL-014",
          "testName": "SQL injection blast-radius mitigation",
          "description": "Ensure application accounts cannot perform administrative actions.",
          "tools": "app account grant review"
        }
      ]
    },
    {
      "name": "Audit, Detection and Recovery",
      "items": [
        {
          "id": "MSSQL-015",
          "testName": "SQL audit and login telemetry coverage",
          "description": "Enable audit trails for logins, permission changes, and schema modifications.",
          "tools": "SQL Audit + SIEM"
        },
        {
          "id": "MSSQL-016",
          "testName": "Suspicious query detection",
          "description": "Monitor for mass export, privilege escalation, and destructive query patterns.",
          "tools": "DB monitoring"
        },
        {
          "id": "MSSQL-017",
          "testName": "Configuration baseline drift checks",
          "description": "Detect unauthorized changes to security-relevant parameters.",
          "tools": "config compliance tools"
        },
        {
          "id": "MSSQL-018",
          "testName": "Patch/CU cadence and vulnerability response",
          "description": "Apply cumulative updates and security patches promptly.",
          "tools": "patch management"
        },
        {
          "id": "MSSQL-019",
          "testName": "Agent job security review",
          "description": "Audit SQL Agent jobs for credential misuse and privilege abuse.",
          "tools": "job inventory + review"
        },
        {
          "id": "MSSQL-020",
          "testName": "Backup restore and integrity tests",
          "description": "Test full/differential/log restore workflows and integrity checks.",
          "tools": "restore drills"
        },
        {
          "id": "MSSQL-021",
          "testName": "Incident response readiness",
          "description": "Validate runbooks for compromise containment and forensic collection.",
          "tools": "IR tabletop"
        }
      ]
    }
  ]
}
